{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,tests/**,notebooks/**,docs/**,annotations/**,scripts/**,assets/**,api/static/**,data/real/**,data/uploads/**,data/synthetic/ru/**,data/synthetic/kz/**,data/synthetic/samples/*/*/text/*.docx,data/synthetic/samples/*/*/scan/*.jpg}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/main"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ],
  "regions": [
    "bom1"
  ]
}
